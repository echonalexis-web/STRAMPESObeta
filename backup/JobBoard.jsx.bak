// Helper to format address for display
const formatAddress = (address) => {
  if (!address) return "Not specified";
  const parts = address.split(", ");
  if (parts.length >= 2) {
    return (
      <>
        <span>{parts[0]}</span>
        <br />
        <span className="text-muted">{parts.slice(1).join(", ")}</span>
      </>
    );
  }
  return address;
};

