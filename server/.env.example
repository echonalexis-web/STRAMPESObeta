# ---- Core ----
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/strampeso
JWT_SECRET=change-me
BASE_URI=/api/v1
CLIENT_ORIGINS=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false
# Skips all express-rate-limit windows. Local convenience only — leave unset
# (or "false") everywhere else; there is no other way to disable rate limiting.
# DISABLE_RATE_LIMITS=true
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000

# ---- File storage ----
# local     = write to ./uploads and serve via /uploads (default; ephemeral on Render)
# cloudinary = upload media + documents to Cloudinary
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=cloudinary. Get it from the Cloudinary dashboard.
# Either set the single URL...
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three parts:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Root folder for all uploads inside Cloudinary
CLOUDINARY_FOLDER=stram-peso

# TTL (seconds) for signed download URLs of private documents (resumes, IDs, permits)
SIGNED_URL_TTL_SECONDS=180

# ---- Email (password reset + email change) ----
# Public base URL of the SPA — used to build reset / verify links.
# Falls back to the first CLIENT_ORIGINS entry when unset.
APP_URL=http://localhost:5173
#
# Transport is Gmail SMTP via nodemailer. Until SMTP_USER + SMTP_PASS are set,
# every "email" is logged to the server console instead. The link is returned
# in the API response as devResetUrl / devVerifyUrl ONLY when EXPOSE_DEV_LINKS
# is set to "true" (local development). It is off by default in every
# environment; never set it on a deployed host.
# EXPOSE_DEV_LINKS=
#
# Gmail setup: enable 2-Step Verification on the Google account, then create an
# App Password (Google Account > Security > App passwords) and use that 16-char
# value as SMTP_PASS — never the normal account password.
# SMTP_SERVICE=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM=STRAM PESO <you@gmail.com>

# ---- Google sign-in ----
# OAuth 2.0 Web client ID from Google Cloud Console
# (APIs & Services > Credentials). Add http://localhost:5173 and the production
# SPA origin to "Authorized JavaScript origins". The SAME id must be set on the
# client as VITE_GOOGLE_CLIENT_ID. Leave blank to disable Google sign-in.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ---- Notification emails (EmailOutbox — see services/emailOutboxService.js) ----
# Mirrors certain in-app notifications (messages, application updates, new
# applicants, job expiring, verification requests, user reports, SPES
# submissions) to email, per the recipient's own Settings preference. Uses
# the same SMTP transport configured above; every value below has a sane
# default and can be left unset.
#
# Set to "false" to disable the background send loop entirely (e.g. for a
# secondary instance that shouldn't send mail, or a test run).
# EMAIL_WORKER_ENABLED=true
#
# How many queued emails one drain cycle (every 30s) sends at most.
# EMAIL_BATCH_SIZE=25
#
# Hard ceiling on emails sent per calendar day — Gmail SMTP caps around 500/day;
# anything queued beyond this cap just waits and sends on a later day/cycle.
# EMAIL_DAILY_CAP=450
#
# How long a "new message" digest email waits after the first message in a
# conversation before sending, so replies within that window fold into one
# email instead of one per message.
# EMAIL_MESSAGE_DIGEST_MINUTES=10
#
# HMAC secret signing the one-click "unsubscribe from this category" link in
# every notification email's footer (no login required to use that link).
# Falls back to JWT_SECRET above when unset — set a distinct value in
# production so the two secrets' blast radius stays separate.
# EMAIL_UNSUB_SECRET=change-me-too
# ID OCR: local engine; use off for manual entry. PDFs/Word remain manual.
OCR_ENGINE=tesseract
OCR_MIN_CONFIDENCE=0.5
# Optional override for bundled English language data (directory with eng.traineddata.gz).
OCR_LANG_PATH=
RECOVERY_REQUEST_DAILY_LIMIT=3
RECOVERY_WORKER_ENABLED=true
# Optional approved office details, included in rejection emails (do not guess).
RECOVERY_OFFICE_ADDRESS=
RECOVERY_OFFICE_HOURS=

# ---- Username-only sign-up (off unless USERNAME_SIGNUP_ENABLED=true) ----
# Read docs/username-signup-rollout.md BEFORE turning this on: the database
# indexes must be swapped first, or the second email-less sign-up fails.
# USERNAME_SIGNUP_ENABLED=false
# Secret mixed into every email-code hash and the sign-up form token. Required
# (32+ random characters) when the flag is on; the server refuses to start
# without it. Never commit a real value and never reuse JWT_SECRET.
# EMAIL_CODE_PEPPER=
# Optional limits (defaults shown). Counts live in the database, so they hold
# across restarts and instances. Raise them if one venue shares one IP.
# SIGNUP_LIMIT_PER_HOUR=30
# SIGNUP_LIMIT_PER_DAY=200
# EMAIL_CODE_REQUEST_LIMIT_PER_HOUR_IP=60
# EMAIL_CODE_VERIFY_LIMIT_PER_HOUR_IP=120
# SIGNUP_TOKEN_LIMIT_PER_HOUR_IP=300
# FORGOT_USERNAME_LIMIT_PER_HOUR_IP=30
# USERNAME_CHECK_LIMIT_PER_MIN=60
# Client build flag (set in the client environment, not here):
# VITE_USERNAME_SIGNUP_ENABLED=false
# Light per-account limits that apply only while the flag is on (defaults shown).
# Counted in the database per account, so a shared IP is not a problem.
# JOB_APPLY_DAILY_CAP=20
# NEW_CONVERSATIONS_DAILY_CAP=20
# UPLOADS_DAILY_CAP=30
# Per staff member, applies whether or not the flag is on.
# STAFF_RESET_HOURLY_CAP=20

# Cover photos and profile viewing. All optional (defaults shown); they apply
# whether or not USERNAME_SIGNUP_ENABLED is on. Counted in the database per account.
# See docs/cover-photo-rollout.md.
# Employer cover image uploads per account per 24 hours (upload and replace):
# COVER_UPLOADS_DAILY_CAP=10
# Profile views (hover cards and profile pages) per account per 24 hours:
# PROFILE_VIEWS_DAILY_CAP=1500
# Short in-memory burst limit per account per minute (resets on restart):
# PROFILE_VIEWS_PER_MINUTE=60
