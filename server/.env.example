# ---- Core ----
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/strampeso
JWT_SECRET=change-me
BASE_URI=/api/v1
CLIENT_ORIGINS=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false
# Skips all express-rate-limit windows. Local convenience only — leave unset
# (or "false") everywhere else; there is no other way to disable rate limiting.
# DISABLE_RATE_LIMITS=true
VITE_API_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000

# ---- File storage ----
# local     = write to ./uploads and serve via /uploads (default; ephemeral on Render)
# cloudinary = upload media + documents to Cloudinary
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=cloudinary. Get it from the Cloudinary dashboard.
# Either set the single URL...
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# ...or the three parts:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Root folder for all uploads inside Cloudinary
CLOUDINARY_FOLDER=stram-peso

# TTL (seconds) for signed download URLs of private documents (resumes, IDs, permits)
SIGNED_URL_TTL_SECONDS=180

# ---- Email (password reset + email change) ----
# Public base URL of the SPA — used to build reset / verify links.
# Falls back to the first CLIENT_ORIGINS entry when unset.
APP_URL=http://localhost:5173
#
# Transport is Gmail SMTP via nodemailer. Until SMTP_USER + SMTP_PASS are set,
# every "email" is logged to the server console instead, and (outside
# production) the link is also returned in the API response as devResetUrl /
# devVerifyUrl.
#
# Gmail setup: enable 2-Step Verification on the Google account, then create an
# App Password (Google Account > Security > App passwords) and use that 16-char
# value as SMTP_PASS — never the normal account password.
# SMTP_SERVICE=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx
# MAIL_FROM=STRAM PESO <you@gmail.com>

# ---- Google sign-in ----
# OAuth 2.0 Web client ID from Google Cloud Console
# (APIs & Services > Credentials). Add http://localhost:5173 and the production
# SPA origin to "Authorized JavaScript origins". The SAME id must be set on the
# client as VITE_GOOGLE_CLIENT_ID. Leave blank to disable Google sign-in.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
